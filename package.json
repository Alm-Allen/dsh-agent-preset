{
  "name": "@alm-allen/dsh-agent-preset",
  "version": "2026.10.31",
  "description": "智能体预设：把雅言、仓颉、马良三个 DSH Agent 预设汉化层合并成一个插件；插件管理页分别启停，默认关闭时保持原生预设。",
  "type": "module",
  "license": "MIT",
  "main": "./plugins/agent-preset.mjs",
  "exports": {
    ".": "./plugins/agent-preset.mjs",
    "./yayan-zh": "./plugins/yayan-zh.mjs",
    "./cangjie-zh": "./plugins/cangjie-zh.mjs",
    "./maliang-zh": "./plugins/maliang-zh.mjs",
    "./list-agents-shim": "./plugins/list-agents-shim.mjs",
    "./hide-harness-source": "./plugins/hide-harness-source.mjs",
    "./client": "./plugins/client.js",
    "./self-test": "./plugins/self-test.mjs",
    "./audit-coverage": "./plugins/audit-coverage.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alm-Allen/dsh-agent-preset.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "yayan",
    "cangjie",
    "maliang"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-subagent-control": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tool-subagent-control": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
